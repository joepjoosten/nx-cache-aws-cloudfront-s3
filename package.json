{
  "name": "nx-cache-aws-cloudfront-s3",
  "version": "0.1.0",
  "description": "Serverless Nx remote cache on AWS: CloudFront uploads and direct S3 downloads, deployed with AWS CDK.",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "configure": "tsx scripts/configure.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "cdk deploy",
    "plan": "cdk diff",
    "destroy": "cdk destroy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke": "tsx scripts/smoke.ts",
    "check": "npm run typecheck && npm test && npm run format:check",
    "synth": "cdk synth",
    "bootstrap": "cdk bootstrap"
  },
  "keywords": [
    "nx",
    "remote-cache",
    "aws",
    "aws-cdk",
    "cloudfront",
    "s3"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.6",
    "aws-cdk": "2.1147.0",
    "esbuild": "0.28.2",
    "nx": "24.0.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
